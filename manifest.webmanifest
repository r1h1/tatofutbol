{
  "name": "TatoTV — Deportes en vivo",
  "short_name": "TatoTV",
  "description": "Agenda deportiva en vivo, gratuita y de código abierto: fútbol, basketball y hockey con marcadores, noticias y reproductor integrado. Sin cuentas y sin rastreadores propios.",
  "lang": "es",
  "id": "./",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "prefer_related_applications": false,
  "background_color": "#fd7002",
  "theme_color": "#0d0e10",
  "categories": [
    "sports",
    "entertainment",
    "news"
  ],
